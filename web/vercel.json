{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/installation",
      "destination": "/install",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/architecture",
      "permanent": true
    },
    {
      "source": "/features/commands",
      "destination": "/commands",
      "permanent": true
    },
    {
      "source": "/features/commands-workflows",
      "destination": "/commands",
      "permanent": true
    },
    {
      "source": "/features/specialist-agents",
      "destination": "/agents",
      "permanent": true
    },
    {
      "source": "/features/agent-teams",
      "destination": "/agents",
      "permanent": true
    },
    {
      "source": "/features/matrix-skills",
      "destination": "/skills",
      "permanent": true
    },
    {
      "source": "/features",
      "destination": "/architecture",
      "permanent": true
    },
    {
      "source": "/features/:slug*",
      "destination": "/architecture",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/commands",
      "destination": "/commands.html"
    },
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/skills",
      "destination": "/skills.html"
    },
    {
      "source": "/architecture",
      "destination": "/architecture.html"
    },
    {
      "source": "/install",
      "destination": "/install.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://github.com https://raw.githubusercontent.com; media-src 'self' https://github.com https://raw.githubusercontent.com; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
